        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ]
    },
    {
      "kind": "verification",
      "id": "sample-verification",
      "problemId": "sample-problem",
      "validatorId": "synthetic",
      "validatorVersion": "1",
      "inputIdentity": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "observation": "manual-required",
      "controlEvidenceRefs": [],
      "evidenceRefs": []
    },
    {
      "kind": "intelligenceMatch",
      "sbomIdentity": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "componentId": "synthetic-package",
      "componentVersion": "1.0",
      "advisoryId": "example-not-a-real-cve",
