    {
      "kind": "notification",
      "id": "sample-notification",
      "dedupeKey": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "subjectId": "sample-problem",
      "changeType": "new-match",
      "deliveryState": "pending",
      "sourceRevision": "fixture-1"
